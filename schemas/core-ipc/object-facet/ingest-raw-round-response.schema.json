{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet/ingest-raw-round-response.schema.json",
  "title": "LedgerMind object-facet RawRound ingest response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "raw_round_id", "duplicate", "operational_job_id", "status"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "raw_round_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "duplicate": {"type": "boolean"},
    "operational_job_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "status": {"enum": ["queued", "processing", "completed", "failed"]}
  }
}
