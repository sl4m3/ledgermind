{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet/claim-operational-extraction-result.schema.json",
  "title": "LedgerMind claim-first operational extraction result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims", "coverage"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "claims": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/claim"}
    },
    "coverage": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/coverage"}
    }
  },
  "$defs": {
    "facet": {
      "enum": [
        "identity",
        "property",
        "state",
        "function",
        "structure",
        "procedure",
        "maintenance",
        "risk",
        "constraint",
        "preference",
        "decision",
        "experience",
        "relation",
        "event"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_id", "surface_text", "span_start", "span_end"],
      "properties": {
        "source_event_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "surface_text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "span_start": {"type": "integer", "minimum": 0},
        "span_end": {"type": "integer", "minimum": 1}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_id", "surface_text"],
      "properties": {
        "source_event_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "surface_text": {"type": "string", "minLength": 1, "maxLength": 20000}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ref",
        "subject",
        "facet",
        "content",
        "conditions",
        "context_anchor_refs",
        "source_event_ids"
      ],
      "properties": {
        "claim_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "subject": {"$ref": "#/$defs/subject"},
        "facet": {"$ref": "#/$defs/facet"},
        "content": {"type": "string", "minLength": 1, "maxLength": 20000},
        "conditions": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/condition"}
        },
        "context_anchor_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_ref", "disposition", "claim_refs"],
      "properties": {
        "anchor_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "disposition": {
          "enum": ["claim", "duplicate", "ephemeral", "insufficient_evidence"]
        },
        "claim_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"enum": ["claim", "duplicate"]}}},
          "then": {"properties": {"claim_refs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"disposition": {"enum": ["ephemeral", "insufficient_evidence"]}}},
          "then": {"properties": {"claim_refs": {"maxItems": 0}}}
        }
      ]
    }
  }
}
